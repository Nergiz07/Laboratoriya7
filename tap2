<!DOCTYPE html>
<html>
<head>
    <title>Tapşırıq 2</title>
</head>
<body>

<input type="number" id="num1" placeholder="Birinci ədəd">
<input type="number" id="num2" placeholder="İkinci ədəd">

<button onclick="topla()">+</button>
<button onclick="cix()">-</button>

<p id="netice"></p>

<script>
    function topla() {
        let a = Number(document.getElementById("num1").value);
        let b = Number(document.getElementById("num2").value);

        document.getElementById("netice").innerHTML = "Nəticə: " + (a + b);
    }

    function cix() {
        let a = Number(document.getElementById("num1").value);
        let b = Number(document.getElementById("num2").value);

        document.getElementById("netice").innerHTML = "Nəticə: " + (a - b);
    }
</script>

</body>
</html>
