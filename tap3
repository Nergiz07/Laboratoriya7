<!DOCTYPE html>
<html>
<head>
    <title>Tapşırıq 3</title>
</head>
<body>

<h1 id="counter">0</h1>

<button onclick="artir()">Artır</button>
<button onclick="azalt()">Azalt</button>

<script>
    let count = 0;

    function artir() {
        count++;
        document.getElementById("counter").innerHTML = count;
    }

    function azalt() {
        count--;
        document.getElementById("counter").innerHTML = count;
    }
</script>

</body>
</html>
